# Kisan Insurance Portal - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./kisan_insurance.db

# CORS - Allow frontend to connect
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,file://

# Logging
LOG_LEVEL=INFO
